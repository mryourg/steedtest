# URL, который используется, если аргумент командной строки не передан.
SPEEDTEST_URL=https://proof.ovh.net/files/10Mb.dat

# Количество последовательных GET-запросов.
SPEEDTEST_ATTEMPTS=10

# Размер одного чанка при потоковом чтении, в байтах.
SPEEDTEST_CHUNK_SIZE=65536

# Абсолютный таймаут скачивания тела одного ответа, в секундах.
SPEEDTEST_DOWNLOAD_TIMEOUT=30.0

# Таймаут установки соединения, в секундах.
SPEEDTEST_CONNECT_TIMEOUT=10.0

# Таймаут ожидания данных между операциями чтения, в секундах.
SPEEDTEST_READ_TIMEOUT=30.0
